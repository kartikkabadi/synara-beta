{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "types": ["node", "bun"],
    "lib": ["ES2023", "esnext.disposable"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ]
  },
  // device-helper-smoke.ts spawns the helper through the server's sandbox
  // wrapper so the smoke run exercises the same confinement the app applies.
  // Duplicating that logic here is what would let the two drift.
  // The diagnostics contract test imports the worker's validator for the same
  // reason: the collector and the desktop sanitizer must not drift.
  "include": [
    "**/*.ts",
    "../apps/server/src/device/helperSandbox.ts",
    "../apps/desktop/src/diagnosticsSanitizer.ts",
    "../infrastructure/diagnostics-worker/src/contract.ts",
    "../infrastructure/diagnostics-worker/src/index.ts"
  ]
}
